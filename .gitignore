# Onde a base está em cada máquina. O exemplo versionado é configuracao/caminhos.exemplo.yaml.
configuracao/caminhos.local.yaml

# Dados. Nada de imagem médica ou anotação bruta no git.
dados/bruto/*
dados/intermediario/*
dados/processado/*
!dados/**/README.md

# Artefatos de modelo pesados.
modelos/*
!modelos/README.md
*.pth
*.pt
*.joblib
*.pkl
*.h5
*.onnx

# A rede escolhida, o teste final e o modelo simples de comparação entram inteiros: os pesos são
# pequenos e as previsões são o que o grupo usa para avaliar e analisar os erros.
!modelos/cnn_lr_3e-4/
!modelos/cnn_lr_3e-4/modelo.pt
!modelos/cnn_lr_3e-4_teste_final/
!modelos/random_forest_centro/
!modelos/random_forest_centro/modelo.joblib
# O segundo uso do teste (decisão 0009) e as sementes extras da rede escolhida (decisão 0010).
!modelos/random_forest_centro_teste_final/
!modelos/cnn_lr_3e-4_semente_43/
!modelos/cnn_lr_3e-4_semente_43/modelo.pt
!modelos/cnn_lr_3e-4_semente_44/
!modelos/cnn_lr_3e-4_semente_44/modelo.pt
# A rede de conferência do Sprint 5 Review, cubo de 16, medida só na validação.
!modelos/cnn_centro_16/
!modelos/cnn_centro_16/modelo.pt

