utils_content = '''
"""
Funções utilitárias para carregamento de CTs e extração de patches
"""

import numpy as np
import SimpleITK as sitk

from . import config


def load_ct_scan(mhd_path):
    """
    Carregar um CT scan a partir de um arquivo .mhd (formato MetaImage).

    Aplica:
      - Reamostragem para spacing isotrópico (config.RESAMPLE_SPACING)
      - Janelamento de Hounsfield Units (config.HU_WINDOW_MIN/MAX)
      - Normalização para o intervalo [0, 1]

    Parâmetros
    ----------
    mhd_path : str ou Path
        Caminho para o arquivo .mhd

    Retorna
    -------
    ct_array : np.ndarray (float32)
        Volume no formato (D, H, W)
    spacing : tuple
        Espaçamento (z, y, x) após reamostragem, em mm
    """
    image = sitk.ReadImage(str(mhd_path))
    origin = np.array(image.GetOrigin())[::-1]

    original_spacing = np.array(image.GetSpacing())[::-1]  # (x,y,z) -> (z,y,x)
    original_size = np.array(image.GetSize())[::-1]

    new_spacing = np.array([config.RESAMPLE_SPACING] * 3)
    resize_factor = original_spacing / new_spacing
    new_size = np.round(original_size * resize_factor).astype(int)

    resampler = sitk.ResampleImageFilter()
    resampler.SetOutputSpacing(list(new_spacing[::-1]))  # volta para (x,y,z)
    resampler.SetSize([int(s) for s in new_size[::-1]])
    resampler.SetOutputDirection(image.GetDirection())
    resampler.SetOutputOrigin(image.GetOrigin())
    resampler.SetInterpolator(sitk.sitkLinear)
    resampler.SetDefaultPixelValue(config.HU_WINDOW_MIN)

    resampled_image = resampler.Execute(image)

    ct_array = sitk.GetArrayFromImage(resampled_image).astype(np.float32)

    # Janelamento HU
    ct_array = np.clip(ct_array, config.HU_WINDOW_MIN, config.HU_WINDOW_MAX)

    # Normalização [0, 1]
    ct_array = (ct_array - config.HU_WINDOW_MIN) / (config.HU_WINDOW_MAX - config.HU_WINDOW_MIN)

    spacing = tuple(new_spacing)

    return ct_array, spacing, origin


def extract_patch(ct_array, center_zyx, patch_size=None):
    """
    Extrair um patch cúbico centrado em uma coordenada (z, y, x).

    Parâmetros
    ----------
    ct_array : np.ndarray
        Volume (D, H, W)
    center_zyx : tuple(int, int, int)
        Coordenada central (z, y, x) em voxels
    patch_size : int, opcional
        Tamanho do lado do cubo (default: config.PATCH_SIZE)

    Retorna
    -------
    patch : np.ndarray ou None
        Patch (patch_size, patch_size, patch_size), ou None se as
        coordenadas estiverem fora dos limites do volume.
    """
    if patch_size is None:
        patch_size = config.PATCH_SIZE

    z, y, x = center_zyx
    half = patch_size // 2

    z_min, z_max = z - half, z + half
    y_min, y_max = y - half, y + half
    x_min, x_max = x - half, x + half

    if (z_min < 0 or y_min < 0 or x_min < 0 or
            z_max > ct_array.shape[0] or
            y_max > ct_array.shape[1] or
            x_max > ct_array.shape[2]):
        return None

    patch = ct_array[z_min:z_max, y_min:y_max, x_min:x_max]

    if patch.shape != (patch_size, patch_size, patch_size):
        return None

    return patch
'''

