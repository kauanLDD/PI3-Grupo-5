sens4_rf = sensitivity_at_fp(fps_rf, sens_rf, 4)

t0 = time.time()
boot_rf = bootstrap_froc_metrics(y_test, y_pred_proba_test, scanids_test, n_bootstrap=500, seed=42)
print(f"Bootstrap Random Forest concluído em {time.time()-t0:.1f}s")

cpm_rf_mean, cpm_rf_lo, cpm_rf_hi = ci_95(boot_rf["cpm"])
sens1_rf_mean, sens1_rf_lo, sens1_rf_hi = ci_95(boot_rf["sens_1fp"])
sens4_rf_mean, sens4_rf_lo, sens4_rf_hi = ci_95(boot_rf["sens_4fp"])


# CNN 3D

n_scans_cnn = len(np.unique(scanids_test_cnn))

fps_cnn, sens_cnn = compute_froc(all_labels, all_probs, scanids_test_cnn, n_scans=n_scans_cnn)
cpm_cnn, cpm_points_cnn = compute_cpm(fps_cnn, sens_cnn)
sens1_cnn = sensitivity_at_fp(fps_cnn, sens_cnn, 1)
sens4_cnn = sensitivity_at_fp(fps_cnn, sens_cnn, 4)

t0 = time.time()
