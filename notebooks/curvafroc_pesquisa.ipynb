import numpy as np
import matplotlib.pyplot as plt

def elongation_ratio(patch, percentile=75):
    """
    Heurística de forma: razão entre o maior e o menor autovalor da matriz
    de covariância espacial dos voxels mais intensos do patch.
    ~1 = estrutura arredondada (nódulo-like); alto = estrutura alongada
    (vaso/brônquio-like).
    """
    thresh = np.percentile(patch, percentile)
    coords = np.argwhere(patch >= thresh)

    if len(coords) < 4:
        return np.nan

    cov = np.cov(coords.T)
    eigvals = np.linalg.eigvalsh(cov)
    eigvals = np.clip(eigvals, 1e-6, None)
    return float(eigvals.max() / eigvals.min())


# Falsos positivos: rótulo verdadeiro = 0, modelo previu = 1.
# Ordenar pelos mais "confiantes" (maior probabilidade prevista) — são os
# casos mais informativos para entender o erro do modelo.
fp_indices = np.where((all_labels == 0) & (all_preds == 1))[0]
fp_indices_sorted = fp_indices[np.argsort(-all_probs[fp_indices])]

n_show = min(9, len(fp_indices_sorted))
print(f"Total de falsos positivos no teste (CNN 3D): {len(fp_indices)}")
print(f"Mostrando os {n_show} mais confiantes:\n")

if n_show == 0:
    print("Nenhum falso positivo encontrado no teste — nada para analisar aqui.")
else:
    fig, axes = plt.subplots(3, 3, figsize=(11, 11))
    axes = axes.flatten()

    for ax_i, idx in enumerate(fp_indices_sorted[:n_show]):
        patch = X_test_cnn[idx]
        central_slice = patch[patch.shape[0] // 2]
        ratio = elongation_ratio(patch)

        forma = "alongada (vaso/brônquio?)" if ratio > 3 else "arredondada (?)"

        axes[ax_i].imshow(central_slice, cmap="gray")
        axes[ax_i].set_title(
            f"prob={all_probs[idx]:.2f} | alongamento={ratio:.1f}\n{forma}",
            fontsize=9
        )
        axes[ax_i].axis("off")

    for ax_i in range(n_show, 9):
        axes[ax_i].axis("off")

    plt.suptitle("Falsos Positivos mais confiantes — CNN 3D (fatia central do patch)", y=1.00)
    plt.tight_layout()
    plt.savefig(config.RESULTS_DIR / "false_positives_analysis.png", dpi=150)
    plt.show()

    ratios = [elongation_ratio(X_test_cnn[i]) for i in fp_indices_sorted[:n_show]]
    ratios = [r for r in ratios if not np.isnan(r)]
    print(f"\nAlongamento médio dos FPs mostrados: {np.mean(ratios):.2f}")
    print(
        )."
    )
    print(f"\nAnálise salva em: results/false_positives_analysis.png")






