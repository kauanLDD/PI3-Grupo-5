        label = row["class"]

        # Converter coordenadas físicas para voxels
        world_coord = np.array([z, y, x])

        voxel_coord = (
            (world_coord - origin) / spacing
        ).astype(int)

        voxel_z, voxel_y, voxel_x = voxel_coord

        print(
            f"Candidato {idx}: "
            f"World=({x:.1f}, {y:.1f}, {z:.1f}) "
            f"-> Voxel=({voxel_z}, {voxel_y}, {voxel_x})"
        )

        patch = utils.extract_patch(
            ct_array,
            (voxel_z, voxel_y, voxel_x),
            patch_size=32
        )

        if patch is not None:
            patches_extracted += 1

            print(
                f"   Label={label}, "
                f"Patch shape={patch.shape}"
            )
