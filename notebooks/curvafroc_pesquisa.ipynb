    import traceback
    traceback.print_exc()





from sklearn.model_selection import train_test_split
from scipy.stats import kurtosis
import gc

print("Preparando dataset para treinamento...\n")

X = []
y = []
scan_ids_list = []

# Agrupar candidatos por CT: assim cada CT é carregado UMA única vez,
# usado para extrair todos os patches dele, e descartado da memória
# antes de carregar o próximo. Isso evita estourar a RAM do Kaggle
# (guardar todos os CTs em cache ao mesmo tempo pode passar de 100GB).
grouped = candidates_df.groupby('seriesuid')
matched_scan_ids = set(candidates_df['seriesuid']).intersection(scan_paths.keys())

print(f"Total de candidatos: {len(candidates_df)}")
print(f"Total de CTs distintos com candidatos: {candidates_df['seriesuid'].nunique()}")
print(f"CTs realmente disponíveis no dataset: {len(matched_scan_ids)}")
print("Processando CT por CT (um de cada vez, para economizar RAM)...\n")

contador = 0
scan_num = 0

for scan_id, group in grouped:
    if scan_id not in scan_paths:
        continue  # CT correspondente não está disponível no dataset

    scan_num += 1
    if scan_num % 25 == 0 or scan_num == 1:
        print(f"  CT {scan_num}/{len(matched_scan_ids)} ({scan_id}) — {len(group)} candidatos")

    try:
        ct_array_i, spacing_i, origin_i = utils.load_ct_scan(scan_paths[scan_id])
    except Exception as e:
        continue  # não conseguiu carregar este CT, pula para o próximo

    for idx, row in group.iterrows():
        try:
            x, y_coord, z = row['coordX'], row['coordY'], row['coordZ']
            label = row['class']

            # Converter coordenada física (mm) -> voxel
            world_coord = np.array([z, y_coord, x])
            voxel_coord = ((world_coord - origin_i) / spacing_i).astype(int)
            voxel_z, voxel_y, voxel_x = voxel_coord

            patch = utils.extract_patch(ct_array_i, (voxel_z, voxel_y, voxel_x), patch_size=32)

            if patch is not None:
                # Extrair features: média, std, min, max, percentis
                features = [
                    np.mean(patch),
                    np.std(patch),
                    kurtosis(patch.flatten()),  # exigido no protocolo do PI3 (seção 4.4)
                    np.min(patch),
                    np.max(patch),
                    np.percentile(patch, 25),
                    np.percentile(patch, 75)
                ]

                X.append(features)
                y.append(label)
                scan_ids_list.append(scan_id)
                contador += 1

        except Exception as e:
            pass  # Skip candidato se falhar

    # Liberar o CT da memória antes de seguir para o próximo
    del ct_array_i
    gc.collect()

X = np.array(X)
y = np.array(y)

print(f"\n Features extraídas: {len(X)}")
print(f"  Shape X: {X.shape}")
print(f"  Shape y: {y.shape}")
print(f"  Classes: {np.bincount(y.astype(int))}")

# Split por paciente
unique_patients = np.unique(scan_ids_list)
train_patients, test_patients = train_test_split(
    unique_patients,
    test_size=0.2,
    random_state=42
)

# Filtrar
train_mask = np.isin(scan_ids_list, train_patients)
test_mask = ~train_mask

X_train, X_test = X[train_mask], X[test_mask]
y_train, y_test = y[train_mask], y[test_mask]

# Guardar os scan_ids alinhados a X_train/X_test (necessário para calcular
# a curva FROC depois, que precisa saber a quantos exames distintos
# pertencem os falsos positivos)
scan_ids_arr = np.array(scan_ids_list)
scanids_train = scan_ids_arr[train_mask]
scanids_test = scan_ids_arr[test_mask]

print(f"\nTrain: {len(X_train)} ({len(train_patients)} pacientes)")
print(f"Test:  {len(X_test)} ({len(test_patients)} pacientes)")
print(f"Train class dist: {np.bincount(y_train.astype(int))}")
print(f"Test class dist:  {np.bincount(y_test.astype(int))}")






from sklearn.ensemble import RandomForestClassifier
from sklearn.metrics import confusion_matrix, accuracy_score, precision_score, recall_score, f1_score
import pickle

print("Treinando Random Forest...\n")

# Dataset LUNA16 é extremamente desbalanceado (poucos nódulos verdadeiros
# para muitos candidatos negativos). class_weight='balanced' faz o modelo
# dar mais peso à classe rara durante o treino, em vez de simplesmente
# aprender a prever sempre a classe majoritária.
print(f"Distribuição no treino: {dict(zip(*np.unique(y_train, return_counts=True)))}")

# Criar modelo
rf = RandomForestClassifier(
    n_estimators=100,
    max_depth=20,
    class_weight='balanced',
    random_state=42,
    n_jobs=-1  # Usar todas CPUs
)

# Treinar
print("Ajustando modelo (isto pode levar 2-5 minutos)...")
rf.fit(X_train, y_train)

print(" Modelo treinado!\n")

# Avaliar
y_pred_train = rf.predict(X_train)
y_pred_test = rf.predict(X_test)
y_pred_proba_test = rf.predict_proba(X_test)[:, 1]

print("RESULTADOS TREINO:")
print(f"  Acurácia: {accuracy_score(y_train, y_pred_train):.3f}")

print("\nRESULTADOS TESTE:")
print(f"  Acurácia: {accuracy_score(y_test, y_pred_test):.3f}")
print(f"  Precisão: {precision_score(y_test, y_pred_test, zero_division=0):.3f}")
print(f"  Recall:   {recall_score(y_test, y_pred_test, zero_division=0):.3f}")
print(f"  F1-Score: {f1_score(y_test, y_pred_test, zero_division=0):.3f}")

print("\nMatriz de Confusão (Teste):")
cm = confusion_matrix(y_test, y_pred_test)
print(cm)

if y_pred_test.sum() == 0:
    print(
        "\n Atenção: o modelo não previu NENHUM candidato como positivo no teste."
        "\n   Isso costuma indicar desbalanceamento severo entre as classes."
        "\n   Considere: ajustar o threshold de decisão a partir de y_pred_proba_test,"
        "\n   usar undersampling da classe majoritária, ou testar outro modelo/features."
    )

# Salvar modelo
model_path = config.MODELS_DIR / 'baseline_rf.pkl'
with open(model_path, 'wb') as f:
    pickle.dump(rf, f)

print(f"\n Modelo salvo em: {model_path}")






import matplotlib.pyplot as plt
from sklearn.metrics import roc_curve, auc, confusion_matrix
import seaborn as sns

print("Gerando visualizações...\n")

fig, axes = plt.subplots(1, 2, figsize=(12, 4))

# Confusion Matrix
cm = confusion_matrix(y_test, y_pred_test)
sns.heatmap(cm, annot=True, fmt='d', cmap='Blues', ax=axes[0])
axes[0].set_title('Matriz de Confusão - Random Forest')
axes[0].set_ylabel('Verdadeiro')
axes[0].set_xlabel('Predito')

# ROC Curve
fpr, tpr, _ = roc_curve(y_test, y_pred_proba_test)
roc_auc = auc(fpr, tpr)

axes[1].plot(fpr, tpr, color='darkorange', lw=2, label=f'ROC (AUC={roc_auc:.2f})')
axes[1].plot([0, 1], [0, 1], color='navy', lw=2, linestyle='--')
axes[1].set_xlim([0.0, 1.0])
axes[1].set_ylim([0.0, 1.05])
axes[1].set_xlabel('Taxa FP')
axes[1].set_ylabel('Taxa TP')
axes[1].set_title('Curva ROC - Random Forest')
