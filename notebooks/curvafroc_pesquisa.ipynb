import numpy as np
# FUNÇÕES DE AVALIAÇÃO FROC (padrão do desafio LUNA16)

def compute_froc(y_true, y_scores, scan_ids, n_scans, thresholds=None):
    """
    Calcula a curva FROC: sensibilidade x média de falsos positivos por exame.

    Cada linha em (y_true, y_scores, scan_ids) é um CANDIDATO. Um candidato é
    "positivo" num dado threshold se seu score >= threshold.

    Parâmetros
    ----------
    y_true : array (0/1) — rótulo verdadeiro de cada candidato
    y_scores : array (float) — probabilidade prevista pelo modelo
    scan_ids : array — a qual exame (seriesuid) cada candidato pertence
    n_scans : int — número de exames DISTINTOS no conjunto avaliado
              (denominador do FP/scan; inclui exames sem nenhum candidato positivo)
    thresholds : array opcional de thresholds a avaliar (default: todos os scores únicos)

    Retorna
    -------
    fps_per_scan, sensitivities : arrays ordenados por fps_per_scan crescente
    """
    y_true = np.asarray(y_true)
    y_scores = np.asarray(y_scores)
    scan_ids = np.asarray(scan_ids)

    n_true_nodules = int(y_true.sum())

    if thresholds is None:
        thresholds = np.unique(y_scores)
        thresholds = np.concatenate([thresholds, [thresholds.max() + 1e-6]])

    sensitivities = []
    fps_per_scan = []

    for t in thresholds:
        predicted_positive = y_scores >= t

        tp = int(np.sum(predicted_positive & (y_true == 1)))
        fp = int(np.sum(predicted_positive & (y_true == 0)))

        sens = tp / n_true_nodules if n_true_nodules > 0 else 0.0
        fp_scan = fp / n_scans if n_scans > 0 else 0.0

        sensitivities.append(sens)
        fps_per_scan.append(fp_scan)

    order = np.argsort(fps_per_scan)
    return np.array(fps_per_scan)[order], np.array(sensitivities)[order]


def sensitivity_at_fp(fps_per_scan, sensitivities, target_fp):
    """Interpola a sensibilidade num ponto específico de FP/scan."""
    return float(np.interp(target_fp, fps_per_scan, sensitivities))


def compute_cpm(fps_per_scan, sensitivities,
                 operating_points=(0.125, 0.25, 0.5, 1, 2, 4, 8)):
    """CPM = média da sensibilidade interpolada nos 7 pontos padrão do LUNA16."""
    sens_at_points = [sensitivity_at_fp(fps_per_scan, sensitivities, p) for p in operating_points]
    return float(np.mean(sens_at_points)), dict(zip(operating_points, sens_at_points))


def bootstrap_froc_metrics(y_true, y_scores, scan_ids, n_bootstrap=500, seed=42):
    """
    Bootstrap por PACIENTE (não por candidato) das métricas derivadas da FROC:
    CPM, sensibilidade a 1 FP/scan e a 4 FP/scan.

    Em cada iteração: reamostra os exames (scan_ids únicos) COM reposição,
    reconstrói o conjunto de candidatos correspondente, recalcula a FROC.
    """
    rng = np.random.default_rng(seed)
    y_true = np.asarray(y_true)
    y_scores = np.asarray(y_scores)
    scan_ids = np.asarray(scan_ids)

    unique_scans = np.unique(scan_ids)
    n_scans = len(unique_scans)

    cpm_samples, sens1_samples, sens4_samples = [], [], []

    for _ in range(n_bootstrap):
        sampled_scans = rng.choice(unique_scans, size=n_scans, replace=True)

        # Reconstruir candidatos de todos os exames sorteados (com repetição)
        idx_parts = [np.where(scan_ids == s)[0] for s in sampled_scans]
        idx = np.concatenate(idx_parts) if idx_parts else np.array([], dtype=int)

        if len(idx) == 0 or y_true[idx].sum() == 0:
            continue

        fps_b, sens_b = compute_froc(y_true[idx], y_scores[idx], scan_ids[idx], n_scans=n_scans)
        cpm_b, _ = compute_cpm(fps_b, sens_b)

        cpm_samples.append(cpm_b)
        sens1_samples.append(sensitivity_at_fp(fps_b, sens_b, 1))
        sens4_samples.append(sensitivity_at_fp(fps_b, sens_b, 4))

    return {
        "cpm": np.array(cpm_samples),
        "sens_1fp": np.array(sens1_samples),
        "sens_4fp": np.array(sens4_samples),
    }


def ci_95(values):
    """Média + intervalo de confiança de 95% (percentil 2.5 / 97.5) via bootstrap."""
    values = np.asarray(values)
    return float(np.mean(values)), float(np.percentile(values, 2.5)), float(np.percentile(values, 97.5))


print("Funções de avaliação FROC/CPM/bootstrap definidas.")



